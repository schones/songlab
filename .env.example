# Local development environment variables
# Copy this file to .env and fill in your values.
# .env is gitignored and will not be committed.
#
#   cp .env.example .env
#
# There is no hosted deployment at the moment (the Railway project was
# removed in Oct 2026). When one is set up, provide these as environment
# variables there — do not commit .env to the repository.

ANTHROPIC_API_KEY=your-key-here
